{
  "name": "@zodal/groups-store-fs",
  "version": "0.1.0",
  "description": "Node filesystem GroupStore for zodal-groups: the DAG and memberships in one sidecar JSON manifest, written atomically",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "publishConfig": { "access": "public" },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "scripts": { "build": "tsup", "prepublishOnly": "pnpm build", "test": "vitest run", "typecheck": "tsc --noEmit" },
  "peerDependencies": { "@zodal/groups-core": "^0.2.0" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@zodal/groups-core": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
