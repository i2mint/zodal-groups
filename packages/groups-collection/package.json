{
  "name": "@zodal/groups-collection",
  "version": "0.1.0",
  "description": "One CRUD object over a zodal item collection and its zodal-groups memberships: create-with-groups, bulk tag, rename, merge, delete — every operation returns its inverse",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "publishConfig": { "access": "public" },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zodal/groups-core": "workspace:^"
  },
  "peerDependencies": {
    "@zodal/core": "^0.2.0",
    "@zodal/store": "^0.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@zodal/core": "^0.2.0",
    "@zodal/groups-store-fs": "workspace:*",
    "@zodal/store": "^0.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^4.4.0"
  }
}
